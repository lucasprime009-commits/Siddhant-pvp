local function L(key)
    local langTable = Localizations[getgenv().__SiddhantLanguage]
    if langTable and langTable[key] then
        return langTable[key]
    end
    return Localizations.English[key] or key
end

local function getNextActiveLanguage()
    local order = {"English", "Chinese", "Nepali", "Hindi"}
    local currentIndex = 1
    for i, lang in ipairs(order) do
        if lang == getgenv().__SiddhantLanguage then
            currentIndex = i
            break
        end
    end
    
    for i = 1, 4 do
        currentIndex = (currentIndex % 4) + 1
        local candidate = order[currentIndex]
        if getgenv().__LangEnabled[candidate] then
            return candidate
        end
    end
    return getgenv().__SiddhantLanguage
end

