    -- Helper: Flexible Target Tracker filtered by Specific Player, All Players, NPCs, and Bosses
    local function getClosestTarget()
        local target = nil
        local shortest = math.huge
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
        
        -- 1. Specific Player Lock Priority
        if getgenv().__TargetStates.SpecificPlayer and getgenv().__SelectedSpecificPlayer then
            local sp = getgenv().__SelectedSpecificPlayer
            if sp ~= LocalPlayer and sp.Character and sp.Character:FindFirstChild("HumanoidRootPart") and sp.Character:FindFirstChild("Humanoid") and sp.Character.Humanoid.Health > 0 then
                return sp.Character.HumanoidRootPart
            end
        end
        
        -- 2. Target All Players
        if getgenv().__TargetStates.Players then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local dist = (p.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        target = p.Character.HumanoidRootPart
                    end
                end
            end
        end
        
        -- 3. Target NPCs and Bosses across workspace
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj ~= char and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                local humanoid = obj.Humanoid
                local rootPart = obj.HumanoidRootPart
                if humanoid.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                    local isBoss = humanoid.MaxHealth > 5000 or obj.Name:find("Boss") or obj.Name:find("Leader") or obj.Name:find("Admiral") or obj.Name:find("King")
                    
                    if (getgenv().__TargetStates.Bosses and isBoss) or (getgenv().__TargetStates.NPCs and not isBoss) then
                        local dist = (rootPart.Position - char.HumanoidRootPart.Position).Magnitude
                        if dist < shortest and dist < 500 then
                            shortest = dist
                            target = rootPart
                        end
                    end
                end
            end
        end
        
        return target
    end
    
    -- Helper: Modular Individual ESP Engine (1 by 1)
    local activeHighlights = {}
    local activeBillboards = {}
    
    local function updateESP()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                -- 1. Box Highlight
                if getgenv().__ESPStates.Box then
                    if not activeHighlights[p] then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "SiddhantESPHighlight"
                        highlight.FillColor = Color3.fromRGB(255, 50, 50)
                        highlight.OutlineColor = Color3.fromRGB(255, 210, 31)
                        highlight.FillTransparency = 0.5
                        highlight.Parent = p.Character
                        activeHighlights[p] = highlight
                    end
                else
                    if activeHighlights[p] then
                        activeHighlights[p]:Destroy()
                        activeHighlights[p] = nil
                    end
                end
                
                -- 2. Billboard Info Display
                local anyInfoEnabled = getgenv().__ESPStates.Name or getgenv().__ESPStates.Bounty or getgenv().__ESPStates.Health or getgenv().__ESPStates.Level
                
                if anyInfoEnabled then
                    if not activeBillboards[p] and p.Character:FindFirstChild("Head") then
                        local billboard = Instance.new("BillboardGui")
                        billboard.Name = "SiddhantESPInfo"
                        billboard.Size = UDim2.fromOffset(220, 80)
                        billboard.StudsOffset = Vector3.new(0, 3, 0)
                        billboard.AlwaysOnTop = true
                        billboard.Parent = p.Character.Head
                        
                        local infoLabel = Instance.new("TextLabel")
                        infoLabel.Name = "InfoText"
                        infoLabel.Size = UDim2.fromScale(1, 1)
                        infoLabel.BackgroundTransparency = 1
                        infoLabel.TextColor3 = Color3.fromRGB(255, 210, 31)
                        infoLabel.TextStrokeTransparency = 0.2
                        infoLabel.TextSize = 12
                        infoLabel.Font = Enum.Font.GothamBold
                        infoLabel.TextXAlignment = Enum.TextXAlignment.Center
                        infoLabel.TextVerticalAlignment = Enum.TextVerticalAlignment.Center
                        infoLabel.Parent = billboard
                        
                        activeBillboards[p] = billboard
                    end
                    
                    local billboard = activeBillboards[p]
                    if billboard and billboard:FindFirstChild("InfoText") and p.Character:FindFirstChild("Humanoid") then
                        local hum = p.Character.Humanoid
                        local health = math.floor(hum.Health)
                        local maxHealth = math.floor(hum.MaxHealth)
                        
                        local dataFolder = p:FindFirstChild("Data") or p:FindFirstChild("leaderstats")
                        local level = "N/A"
                        local bounty = "N/A"
                        
                        if dataFolder then
                            local lvlStat = dataFolder:FindFirstChild("Level") or dataFolder:FindFirstChild("LVL")
                            local bnyStat = dataFolder:FindFirstChild("Bounty") or dataFolder:FindFirstChild("Bounty/Honor") or dataFolder:FindFirstChild("Honor")
                            if lvlStat then level = tostring(lvlStat.Value) end
                            if bnyStat then bounty = tostring(bnyStat.Value) end
                        end
                        
                        local textLines = {}
                        if getgenv().__ESPStates.Name then table.insert(textLines, "👤 " .. p.Name) end
                        if getgenv().__ESPStates.Bounty then table.insert(textLines, "💰 Bounty: " .. bounty) end
                        if getgenv().__ESPStates.Health then table.insert(textLines, "❤️ HP: " .. health .. " / " .. maxHealth) end
                        if getgenv().__ESPStates.Level then table.insert(textLines, "⭐ Level: " .. level) end
                        
                        billboard.InfoText.Text = table.concat(textLines, "\n")
                    end
                else
                    if activeBillboards[p] then
                        activeBillboards[p]:Destroy()
                        activeBillboards[p] = nil
                    end
                end
            end
        end
        
        for p, h in pairs(activeHighlights) do
            if not p.Parent or not p.Character then
                if h then h:Destroy() end
                if activeBillboards[p] then activeBillboards[p]:Destroy() end
                activeHighlights[p] = nil
                activeBillboards[p] = nil
            end
        end
    end
    
    -- Main Execution Loop with Shift-Lock Aimbot Integration
    RunService.RenderStepped:Connect(function()
        pcall(function()
            speedIndicator.Text = tostring(getgenv().__SiddhantFlySpeed)

            -- Auto V3 Logic
            if getgenv().__AutoV3Enabled then
                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Y, false, game)
                    task.wait(0.1)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Y, false, game)
                end)
            end

            -- Auto V4 Awakening Logic
            if getgenv().__AutoV4Enabled then
                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.T, false, game)
                    task.wait(0.1)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.T, false, game)
                end)
            end

            if getgenv().__SiddhantFlyActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character:FindFirstChild("Humanoid") then
                local hrp = LocalPlayer.Character.HumanoidRootPart
                local hum = LocalPlayer.Character.Humanoid
                
                hum.PlatformStand = false
                LocalPlayer.DevEnableMouseLock = false
                
                local moveDir = hum.MoveDirection
                local camLook = Camera.CFrame.LookVector
                local camRight = Camera.CFrame.RightVector
                
                if moveDir.Magnitude > 0 then
                    local flyDir = (camLook * moveDir.Z + camRight * moveDir.X).Unit
                    hrp.AssemblyLinearVelocity = flyDir * getgenv().__SiddhantFlySpeed
                else
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0.1, 0)
                end
            elseif LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                if not getgenv().__SiddhantSkillAimbot then
                    LocalPlayer.DevEnableMouseLock = true
                end
            end

            -- SHIFT-LOCK SKILL & MOVE AIMBOT INTEGRATION
            if getgenv().__SiddhantSkillAimbot then
                LocalPlayer.DevEnableMouseLock = true
                local targetPart = getClosestTarget()
                if targetPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = LocalPlayer.Character.HumanoidRootPart
                    local currentPos = Camera.CFrame.Position
                    Camera.CFrame = CFrame.new(currentPos, targetPart.Position)
                    
                    local lookAtPos = Vector3.new(targetPart.Position.X, hrp.Position.Y, targetPart.Position.Z)
                    hrp.CFrame = CFrame.new(hrp.Position, lookAtPos)
                end
            end
            
            if getgenv().__SiddhantFastAttack then
                pcall(function()
                    local combatFramework = debug.getupvalues(require(LocalPlayer.PlayerScripts.CombatFramework))
                    local combatFrameworkRemote = combatFramework[2]
                    if combatFrameworkRemote and type(combatFrameworkRemote) == "table" then
                        for _, v in pairs(combatFrameworkRemote) do
                            if typeof(v) == "function" then
                                pcall(v)
                            end
                        end
                    end
                end)
            end

            if getgenv().__SiddhantSlintM then
                pcall(function()
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local targetPart = getClosestTarget()
                        if targetPart and (targetPart.Position - char.HumanoidRootPart.Position).Magnitude <= 35 then
                            local combatFramework = debug.getupvalues(require(LocalPlayer.PlayerScripts.CombatFramework))
                            local combatFrameworkRemote = combatFramework[2]
                            if combatFrameworkRemote and type(combatFrameworkRemote) == "table" then
                                for _, v in pairs(combatFrameworkRemote) do
                                    if typeof(v) == "function" then
                                        pcall(v)
                                    end
                                end
                            end
                        end
                    end
                end)
            end
            
            if getgenv().__SiddhantSpeedBoost and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = getgenv().__SiddhantCustomWalkSpeed
                LocalPlayer.Character.Humanoid.JumpPower = getgenv().__SiddhantCustomJumpPower
            end
            
            if getgenv().__SiddhantESP then
                updateESP()
            else
                for _, h in pairs(activeHighlights) do if h then h:Destroy() end end
                for _, b in pairs(activeBillboards) do if b then b:Destroy() end end
                activeHighlights = {}
                activeBillboards = {}
            end
        end)
    end)
    
    print("Siddhant Hub Player Selector Edition is fully active!")
end)
